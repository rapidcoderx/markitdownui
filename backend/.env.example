# Copy this file to .env and fill in your values.
# dev.sh loads backend/.env automatically on startup.

# ── LLM Vision for images (optional) ─────────────────────────────────────────
# When set, PNG/JPG/JPEG/GIF/BMP/WEBP files are described using an LLM.
# Priority: ANTHROPIC_API_KEY takes precedence over OPENAI_API_KEY.

# Option A – Anthropic Claude (recommended)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-4-5-20251001   # default — fast & cheap
# CLAUDE_MODEL=claude-sonnet-4-6           # balanced
# CLAUDE_MODEL=claude-opus-4-6             # best quality

# Option B – OpenAI GPT-5 mini
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini      # default — fast & cheap
# OPENAI_MODEL=gpt-5.2         # better quality

# ── Server ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=DEBUG   # DEBUG | INFO | WARNING | ERROR

# ── Upload limits ─────────────────────────────────────────────────────────────
# Maximum upload size in MB. Default: 20. Hard cap enforced by server: 50.
# MAX_UPLOAD_MB=20

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default: http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
