{
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "env": {
    "VERCEL": "1",
    "LOG_LEVEL": "INFO"
  }
}
